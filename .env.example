# Engine selection: 'groq' (free cloud dummy/STT), 'sarvam' (production Sarvam AI pipeline), or 'dummy' (zero-cost timer fallback)
DUBBING_ENGINE=groq

# Groq Cloud API (Free tier: cloud-hosted Whisper large-v3 for instant STT, 0 local CPU)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI API Configuration (Kept in memory for instant rollback to Sarvam)
# Sign up at https://dashboard.sarvam.ai to obtain your API key with starter credits
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: ElevenLabs API Key (for premium international voice cloning)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
